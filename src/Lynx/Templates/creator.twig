class {{ className }}Creator
{
    private array $fields = [];
    private array $errors = [];

    {% for field in fields %}
        {% if field.required %}
            function set{{ field.name|capitalize }}({{ field.type }} ${{ field.name }}): {{ className }}Creator
            {

             if (empty(${{ field.name }})) {
                $this->errors[] = '{{ field.name }} is required';
             }
             $this->fields[':{{ field.name }}'] = ${{ field.name }};
             return $this;
            }
        {% else %}
            function set{{ field.name|capitalize }}(?{{ field.type }} ${{ field.name }} = null): {{ className }}Creator
            {
            $this->fields[':{{ field.name }}'] = ${{ field.name }};
            return $this;
            }
        {% endif %}
    {% endfor %}

    function save(): bool
    {
        if (!empty($this->errors)) {
        throw new ValidationException(implode(', ', $this->errors));
        }

        $pdo = Database::connection();
        $tableFields = implode(', ', array_keys($this->fields));
        $cleanTableFields = str_replace(':', '', $tableFields);
        $sql = "INSERT INTO {{ tableName }} ($cleanTableFields) VALUES ($tableFields)";
        $stmt = $pdo->prepare($sql);

        return $stmt->execute($this->fields);
    }
}